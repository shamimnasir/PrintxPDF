# Canonical origin used for canonical tags, sitemap and structured data (build + runtime)
# VITE_SITE_URL=https://printxpdf.com
# The billing + conversion API (worker/). Defaults to https://api.printxpdf.com
# VITE_API_BASE=https://api.printxpdf.com
# Fetch proxy for the web-page cleaner; the API exposes one at /fetch. Leave unset to use public reader proxies.
# VITE_FETCH_PROXY=https://api.printxpdf.com/fetch
# Optional: sub-path hosting (GitHub Pages sets this automatically in CI)
# VITE_BASE=/PrintxPDF/
