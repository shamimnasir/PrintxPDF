{
  "manifest_version": 3,
  "name": "PrintxPDF — Print Web Pages Clean",
  "short_name": "PrintxPDF",
  "version": "1.0.0",
  "description": "Strip ads, menus and comment walls from any page, then print it or save it as a PDF. One click, nothing uploaded.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://printxpdf.com",
  "permissions": ["activeTab", "contextMenus", "storage", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clean this page for printing",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "clean-current-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Clean the current page for printing"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
